# Dart / Flutter
.dart_tool/
.packages
build/
pubspec.lock
!packages/*/pubspec.lock
doc/api/

# Upstream sources, fetched not authored. Large, and not ours.
reference/

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store

# Scratch probes written by tooling; never part of the package.
packages/*/bin/_tmp_*.dart

# Secrets. This repository is public, and the broadcast test reads a private
# key from the environment — keys live in ~/.flare-dart/, never in the tree.
# Belt-and-braces against a stray `git add -A`.
*.env
!.env.example
.env*
*.key
*.pem
secrets/
**/private_key*
**/*keystore*
